# ============================================================
# OmniCore — Environment Configuration
# Kopyalama: cp .env.example .env   (ardından API key'leri doldurun)
# ============================================================

# =============================================================
# AKTIF PROVIDER: Hangi LLM kullanılacak?
# Seçenekler: gemini | groq | openai | anthropic | deepseek | mistral | ollama
# =============================================================
LLM_PROVIDER=gemini

# Fallback sırası (provider sorunlarında otomatik geçiş)
LLM_FALLBACK_ORDER=groq,gemini

# =============================================================
# GOOGLE GEMINI (varsayılan provider)
# API key: https://aistudio.google.com/app/apikey
# =============================================================
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=

# Gemini Model (önerilen: gemini-2.5-flash veya gemini-2.5-pro)
OMNI_LLM_MODEL=gemini-2.5-flash

# =============================================================
# GROQ (hızlı inference, ücretsiz tier var)
# API key: https://console.groq.com/keys
# =============================================================
GROQ_API_KEY=your-groq-api-key-here

# Çoklu key (round-robin yük dağılımı için)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Groq model fallback zinciri
GROQ_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL_1=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL_2=mixtral-8x7b-32768

# =============================================================
# OPENAI (ChatGPT, GPT-4o, o3-mini)
# API key: https://platform.openai.com/api-keys
# =============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# İsteğe bağlı: OpenAI-uyumlu başka bir endpoint (boş = resmi OpenAI)
OPENAI_BASE_URL=

# =============================================================
# ANTHROPIC (Claude Opus, Sonnet, Haiku)
# API key: https://console.anthropic.com/account/keys
# =============================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-3-5

# =============================================================
# DEEPSEEK (maliyet-etkin reasoning modeli)
# API key: https://platform.deepseek.com/api_keys
# =============================================================
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# =============================================================
# MISTRAL
# API key: https://console.mistral.ai/api-keys
# =============================================================
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# =============================================================
# OLLAMA (yerel, ücretsiz — internet gerektirmez)
# Kurulum: https://ollama.ai/download
# =============================================================
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# =============================================================
# TELEGRAM BOT (isteğe bağlı)
# Bot oluşturma: @BotFather'a /newbot
# =============================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USERS=

# =============================================================
# HITL GUARDIAN (Human-in-the-Loop güvenlik katmanı)
# =============================================================
HITL_TIMEOUT_MINUTES=5

# =============================================================
# HYBRID FALLBACK (CLI → GUI geçiş)
# =============================================================
HYBRID_FALLBACK_ENABLED=true
HYBRID_FALLBACK_MAX_STEPS=4

# =============================================================
# VERİ VE BELLEK YOLLARI
# =============================================================
CHROMA_PERSIST_DIR=./data/chromadb
SQLITE_DB_PATH=./data/omnicore.db

# =============================================================
# LOGLAMA
# =============================================================
LOG_LEVEL=INFO

# =============================================================
# ZAMANLAYICI (Otonom görev planlayıcı)
# =============================================================
SCHEDULER_ENABLED=true

# =============================================================
# REST API (isteğe bağlı Bearer token auth)
# Boş bırakılırsa açık mod (auth yok)
# =============================================================
REST_API_KEY=

# =============================================================
# KİŞİSELLEŞTİRME
# =============================================================
# Görünür isim (boş = "OmniCore" kullanılır)
USER_NAME=
