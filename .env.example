# ============================================================
# OmniCore — Çevre Değişkenleri Konfigürasyonu (.env)
# Kopyalama: cp .env.example .env   (ardından kullanmak istediğiniz API key'leri doldurun)
# ============================================================

# =============================================================
# AKTİF PROVIDER: Hangi LLM kullanılacak?
# Seçenekler:
#   Temel: gemini | groq | openai | anthropic | deepseek | mistral | ollama
#   Gelişmiş: xai | cohere | ai21 | perplexity | reka | writer
#   Hızlı Bulut/Inference: fireworks | together | deepinfra | novita | cerebras | sambanova | hyperbolic | nebius | siliconflow | nvidia | lepton | openrouter
#   Çin/Asya Modelleri: moonshot | zhipu | minimax | qwen | stepfun
# =============================================================
LLM_PROVIDER=gemini

# Fallback sırası (provider hata verdiğinde veya kota dolduğunda otomatik geçiş sırası)
LLM_FALLBACK_ORDER=groq,gemini,openai,deepseek

# =============================================================
# GOOGLE GEMINI (varsayılan provider)
# API key: https://aistudio.google.com/app/apikey
# =============================================================
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=

# Gemini Model (önerilen: gemini-2.5-flash veya gemini-2.5-pro)
OMNI_LLM_MODEL=gemini-2.5-flash

# =============================================================
# GROQ (ultra hızlı inference, cömert ücretsiz tier)
# API key: https://console.groq.com/keys
# =============================================================
GROQ_API_KEY=your-groq-api-key-here

# Çoklu key (round-robin yük dağılımı ve kota aşımı rotasyonu için)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Groq model fallback zinciri
GROQ_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL_1=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL_2=mixtral-8x7b-32768

# =============================================================
# OPENAI (ChatGPT, GPT-4o, o3-mini)
# API key: https://platform.openai.com/api-keys
# =============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# İsteğe bağlı: OpenAI-uyumlu başka bir endpoint (boş = resmi OpenAI)
OPENAI_BASE_URL=

# =============================================================
# ANTHROPIC (Claude Opus, Sonnet, Haiku)
# API key: https://console.anthropic.com/account/keys
# =============================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-3-5

# =============================================================
# xAI (Grok 3, Grok 3 Mini, Grok 2)
# API key: https://console.x.ai/
# =============================================================
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# =============================================================
# DEEPSEEK (maliyet-etkin reasoning ve chat modeli)
# API key: https://platform.deepseek.com/api_keys
# =============================================================
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# =============================================================
# PERPLEXITY (Canlı web arama ve Sonar modelleri)
# API key: https://www.perplexity.ai/settings/api
# =============================================================
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# =============================================================
# MISTRAL
# API key: https://console.mistral.ai/api-keys
# =============================================================
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# =============================================================
# COHERE (Command R+, Command R)
# API key: https://dashboard.cohere.com/api-keys
# =============================================================
COHERE_API_KEY=
COHERE_MODEL=command-r

# =============================================================
# AI21 LABS (Jamba 1.5 Large, Jamba 1.5 Mini)
# API key: https://studio.ai21.com/
# =============================================================
AI21_API_KEY=
AI21_MODEL=jamba-1.5-mini

# =============================================================
# REKA AI (Reka Flash, Reka Core)
# =============================================================
REKA_API_KEY=
REKA_MODEL=reka-flash

# =============================================================
# WRITER (Palmyra)
# =============================================================
WRITER_API_KEY=
WRITER_MODEL=palmyra-x-004

# =============================================================
# HIZLI ÇIKARSAMA VE BULUT SAĞLAYICILARI
# =============================================================
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.3-70B-Instruct

NOVITA_API_KEY=
NOVITA_MODEL=meta-llama/llama-3.3-70b-instruct

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

HYPERBOLIC_API_KEY=
HYPERBOLIC_MODEL=meta-llama/Meta-Llama-3.3-70B-Instruct

NEBIUS_API_KEY=
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

LEPTON_API_KEY=
LEPTON_MODEL=meta-llama/Llama-3.3-70B-Instruct

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# =============================================================
# ASYA / ÇİN DİL VE SAĞLAYICI MODELLERİ
# =============================================================
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-latest

ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-Text-01

QWEN_API_KEY=
QWEN_MODEL=qwen-plus

STEPFUN_API_KEY=
STEPFUN_MODEL=step-2-16k

# =============================================================
# OLLAMA (yerel, tamamen ücretsiz — internet gerektirmez)
# Kurulum: https://ollama.ai/download
# =============================================================
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# =============================================================
# TELEGRAM BOT (isteğe bağlı)
# Bot oluşturma: @BotFather'a /newbot
# =============================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USERS=

# =============================================================
# HITL GUARDIAN (Human-in-the-Loop güvenlik katmanı)
# =============================================================
HITL_TIMEOUT_MINUTES=5

# =============================================================
# HYBRID FALLBACK (CLI → GUI geçiş)
# =============================================================
HYBRID_FALLBACK_ENABLED=true
HYBRID_FALLBACK_MAX_STEPS=4

# =============================================================
# VERİ VE BELLEK YOLLARI
# =============================================================
CHROMA_PERSIST_DIR=./data/chromadb
SQLITE_DB_PATH=./data/omnicore.db

# =============================================================
# LOGLAMA
# =============================================================
LOG_LEVEL=INFO

# =============================================================
# ZAMANLAYICI (Otonom görev planlayıcı)
# =============================================================
SCHEDULER_ENABLED=true

# =============================================================
# REST API (isteğe bağlı Bearer token auth)
# Boş bırakılırsa açık mod (auth yok)
# =============================================================
REST_API_KEY=

# =============================================================
# KİŞİSELLEŞTİRME VE PERSONA
# =============================================================
USER_NAME=mrSpy
SYSTEM_NAME=OmniCore
